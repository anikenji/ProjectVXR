#version 450
// Project VXR: On-Device Synchronous Spacewarp (SSW) Compute Shader
// Reprojects dropped or late video frames on Meta Quest GPU using motion vectors and head delta.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D s_prev_frame;       // Previous rendered color frame
layout(binding = 1) uniform sampler2D s_motion_vectors;   // Motion vectors (2D screen space velocity)
layout(binding = 2) uniform sampler2D s_depth;            // Eye depth buffer
layout(binding = 3, rgba8) uniform writeonly image2D img_reprojected; // Output warped frame

layout(push_constant) uniform SSWConstants {
    vec4 u_resolution;          // xy = width, height; zw = 1/width, 1/height
    mat4 u_rotational_reproject;// Rotational Timewarp delta matrix
    float u_time_delta;         // Interpolation fraction [0.0 .. 1.0]
    float u_mv_scale;           // Motion vector scaling factor
    float u_depth_threshold;    // Occlusion detection threshold
    float u_edge_feather;       // Edge feathering factor
} pc;

void main() {
    ivec2 pixel_coord = ivec2(gl_GlobalInvocationID.xy);
    if (pixel_coord.x >= int(pc.u_resolution.x) || pixel_coord.y >= int(pc.u_resolution.y)) {
        return;
    }

    vec2 uv = (vec2(pixel_coord) + 0.5) * pc.u_resolution.zw;

    // 1. Fetch 2D motion vector at current pixel
    vec2 mv = texture(s_motion_vectors, uv).xy;
    // Map from normalized [0, 1] encoding to [-1, 1] vector if encoded
    mv = (mv * 2.0 - 1.0) * pc.u_mv_scale;

    // 2. Compute backward-warped sampling location
    vec2 sample_uv = uv - mv * pc.u_time_delta;

    // 3. Fallback: If sample is out of bounds or occluded, apply rotational 3DoF ATW
    vec4 final_color;
    if (sample_uv.x < 0.0 || sample_uv.x > 1.0 || sample_uv.y < 0.0 || sample_uv.y > 1.0) {
        // Rotational Reprojection
        vec4 ndc = vec4(uv * 2.0 - 1.0, 1.0, 1.0);
        vec4 reprojected_ndc = pc.u_rotational_reproject * ndc;
        vec2 atw_uv = (reprojected_ndc.xy / reprojected_ndc.w) * 0.5 + 0.5;
        atw_uv = clamp(atw_uv, vec2(0.001), vec2(0.999));
        final_color = texture(s_prev_frame, atw_uv);
    } else {
        // Motion Vector Spacewarp
        final_color = texture(s_prev_frame, sample_uv);
    }

    imageStore(img_reprojected, pixel_coord, final_color);
}
