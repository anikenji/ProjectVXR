#version 450
// Project VXR: AMD FidelityFX Contrast Adaptive Sharpening (CAS) Compute Shader
// Removes video codec compression blur and sharpens stream on Quest Adreno GPU.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D s_input;                        // Input decoded frame
layout(binding = 1, rgba8) uniform writeonly image2D img_sharpened;   // Output sharpened frame

layout(push_constant) uniform CASConstants {
    vec4 u_resolution; // xy = width, height; zw = 1/width, 1/height
    float u_sharpness; // Sharpening intensity [0.0 = off, 1.0 = standard, 2.0 = aggressive]
} pc;

void main() {
    ivec2 pixel_coord = ivec2(gl_GlobalInvocationID.xy);
    if (pixel_coord.x >= int(pc.u_resolution.x) || pixel_coord.y >= int(pc.u_resolution.y)) {
        return;
    }

    vec2 uv = (vec2(pixel_coord) + 0.5) * pc.u_resolution.zw;
    vec2 step = pc.u_resolution.zw;

    // Fetch 5-tap cross neighborhood
    vec3 e = texture(s_input, uv).rgb;                          // Center
    vec3 a = texture(s_input, uv + vec2(0.0, -step.y)).rgb;      // Top
    vec3 b = texture(s_input, uv + vec2(-step.x, 0.0)).rgb;      // Left
    vec3 c = texture(s_input, uv + vec2(step.x, 0.0)).rgb;       // Right
    vec3 d = texture(s_input, uv + vec2(0.0, step.y)).rgb;       // Bottom

    // Fetch 4 diagonal taps
    vec3 tl = texture(s_input, uv + vec2(-step.x, -step.y)).rgb;
    vec3 tr = texture(s_input, uv + vec2(step.x, -step.y)).rgb;
    vec3 bl = texture(s_input, uv + vec2(-step.x, step.y)).rgb;
    vec3 br = texture(s_input, uv + vec2(step.x, step.y)).rgb;

    // Min and max bounds to prevent over-sharpening halos
    vec3 min_rgb = min(min(min(a, b), min(c, d)), e);
    min_rgb = min(min(min(tl, tr), min(bl, br)), min_rgb);

    vec3 max_rgb = max(max(max(a, b), max(c, d)), e);
    max_rgb = max(max(max(tl, tr), max(bl, br)), max_rgb);

    // Adaptive sharpening weight calculation
    vec3 amp_rgb = clamp(min(min_rgb, 2.0 - max_rgb) / max(max_rgb, vec3(1e-5)), 0.0, 1.0);
    vec3 w_rgb = -sqrt(amp_rgb) * (0.25 * pc.u_sharpness);

    // Filter convolution
    vec3 filter_sum = (a + b + c + d) * w_rgb + e;
    vec3 filter_norm = 4.0 * w_rgb + vec3(1.0);

    vec3 result = clamp(filter_sum / filter_norm, min_rgb, max_rgb);

    imageStore(img_sharpened, pixel_coord, vec4(result, 1.0));
}
