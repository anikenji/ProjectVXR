#version 450
// Project VXR: Qualcomm Snapdragon Game Super Resolution (SGSR) Compute Shader
// Edge-directed spatial sharpening optimized for Snapdragon XR2 / Adreno GPU.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D s_input;                        // Input decoded stream
layout(binding = 1, rgba8) uniform writeonly image2D img_upscaled;    // Output sharpened/upscaled frame

layout(push_constant) uniform SGSRConstants {
    vec4 u_resolution;      // xy = width, height; zw = 1/width, 1/height
    float u_edge_threshold; // Edge detection sensitivity [0.05 .. 0.2]
    float u_edge_sharpness; // Edge sharpening strength [0.5 .. 2.0]
} pc;

float rgbToLuma(vec3 rgb) {
    return dot(rgb, vec3(0.299, 0.587, 0.114));
}

void main() {
    ivec2 pixel_coord = ivec2(gl_GlobalInvocationID.xy);
    if (pixel_coord.x >= int(pc.u_resolution.x) || pixel_coord.y >= int(pc.u_resolution.y)) {
        return;
    }

    vec2 uv = (vec2(pixel_coord) + 0.5) * pc.u_resolution.zw;
    vec2 step = pc.u_resolution.zw;

    // 1. Sample central pixel and 4-connected neighbors
    vec3 c  = texture(s_input, uv).rgb;
    vec3 n  = texture(s_input, uv + vec2(0.0, -step.y)).rgb;
    vec3 s  = texture(s_input, uv + vec2(0.0,  step.y)).rgb;
    vec3 w  = texture(s_input, uv + vec2(-step.x, 0.0)).rgb;
    vec3 e  = texture(s_input, uv + vec2( step.x, 0.0)).rgb;

    // 4 diagonal neighbors
    vec3 nw = texture(s_input, uv + vec2(-step.x, -step.y)).rgb;
    vec3 ne = texture(s_input, uv + vec2( step.x, -step.y)).rgb;
    vec3 sw = texture(s_input, uv + vec2(-step.x,  step.y)).rgb;
    vec3 se = texture(s_input, uv + vec2( step.x,  step.y)).rgb;

    // 2. Compute directional luminance gradients (Sobel filter)
    float luma_c  = rgbToLuma(c);
    float luma_n  = rgbToLuma(n);
    float luma_s  = rgbToLuma(s);
    float luma_w  = rgbToLuma(w);
    float luma_e  = rgbToLuma(e);
    float luma_nw = rgbToLuma(nw);
    float luma_ne = rgbToLuma(ne);
    float luma_sw = rgbToLuma(sw);
    float luma_se = rgbToLuma(se);

    float grad_x = (luma_ne + 2.0 * luma_e + luma_se) - (luma_nw + 2.0 * luma_w + luma_sw);
    float grad_y = (luma_sw + 2.0 * luma_s + luma_se) - (luma_nw + 2.0 * luma_n + luma_ne);
    float edge_magnitude = sqrt(grad_x * grad_x + grad_y * grad_y);

    // 3. Directional edge sharpening
    vec3 sharpened;
    if (edge_magnitude > pc.u_edge_threshold) {
        // High edge activity: filter along edge tangent (-grad_y, grad_x) to prevent ringing
        vec2 edge_dir = normalize(vec2(-grad_y, grad_x));
        vec3 t1 = texture(s_input, uv + edge_dir * step * 0.5).rgb;
        vec3 t2 = texture(s_input, uv - edge_dir * step * 0.5).rgb;

        vec3 edge_color = (t1 + t2) * 0.5;
        // High-pass boost
        sharpened = mix(c, 2.0 * c - edge_color, pc.u_edge_sharpness * 0.5);
    } else {
        // Low contrast / flat area: subtle unsharp mask
        vec3 blur = (n + s + w + e) * 0.25;
        sharpened = c + (c - blur) * (pc.u_edge_sharpness * 0.25);
    }

    vec3 min_c = min(min(min(n, s), min(w, e)), c);
    vec3 max_c = max(max(max(n, s), max(w, e)), c);
    sharpened = clamp(sharpened, min_c, max_c);

    imageStore(img_upscaled, pixel_coord, vec4(sharpened, 1.0));
}
